<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="studentPU" transaction-type="RESOURCE_LOCAL">

        <!-- JPA Provider (e.g., Hibernate 7+) -->
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Explicitly register Entity classes (optional if auto-scanning is enabled) -->
        <class>org.example.Student</class>

        <properties>
            <!-- Database Connection Settings (Jakarta Namespace) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/studentsdb?useSSL=false&amp;serverTimezone=UTC" />
            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="107160" />

            <!-- Automatic Schema Generation -->
            <property name="jakarta.persistence.schema-generation.database.action" value="update" />

            <!-- Provider-Specific Settings (Hibernate example) -->
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />
            <property name="hibernate.highlight_sql" value="true" />
        </properties>

    </persistence-unit>

</persistence>